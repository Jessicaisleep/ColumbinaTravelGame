{
  "name": "columbina-travel",
  "version": "1.0.0",
  "private": true,
  "description": "哥伦比娅的旅行：保留旧版兼容入口的 Vite HTML5 游戏项目",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-legacy.mjs",
    "preview": "vite preview",
    "check": "node scripts/check-project.mjs",
    "test": "node scripts/check-project.mjs",
    "content:extract": "node scripts/extract-content.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon 图片素材/图标-512.png",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:android": "npm run build && cap sync android",
    "cap:sync:ios": "npm run build && cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:build": "npm run cap:sync:android && cap build android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tauri-apps/cli": "^2.11.5",
    "node": "24.19.0",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3"
  }
}
